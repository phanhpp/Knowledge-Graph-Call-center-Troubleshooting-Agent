# The agent server: local `uv run langgraph dev`, or the LangSmith deployment URL.
AGENT_SERVER_URL=http://127.0.0.1:2024
# Only for a deployed agent server (sent as X-Api-Key by the proxy route; never reaches the browser).
LANGSMITH_API_KEY=
# The shared password for the web app (proxy.ts, app/api/login).
WEB_PASSWORD=
