# Required now (Phase 0-3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required from Phase 4 (explain_answer, ticket_interpreter, graph_rag_chain synthesis)
ANTHROPIC_API_KEY=

# Required for routing (classify_intent, match_procedure use Jev, TypeSafe's classifier)
TYPESAFE_API_KEY=

# Required from Phase 6 (KB article embeddings — neo4j-graphrag's
# OpenAIEmbeddings reads this from the environment directly, no config.py wiring needed)
OPENAI_API_KEY=

# Required from Phase 4+ (agent tracing) — not needed yet
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=super-agent-kg

# Required only for the Slack bot (see slack_bot/slack_setup.md)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Recommended: one PRIVATE channel ID; its members may use the bot (/agent and DMs).
# Not a public channel: anyone can join one on their own.
SLACK_MEMBERS_CHANNEL=
# Optional: these Slack user IDs may use the bot too (comma-separated)
SLACK_ALLOWED_USERS=
# Optional: channel IDs where /agent may be typed (comma-separated)
SLACK_ALLOWED_CHANNELS=

# Optional: where saved conversations are stored (default checkpoints.db)
CHECKPOINT_DB=

# Optional: how much the agent logs in the terminal (default DEBUG).
# DEBUG: every procedure step with its value, and Jev's confidence numbers.
# INFO: one line per decision (new turn, intent, procedure, final action). WARNING: problems only.
LOG_LEVEL=
