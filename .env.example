# Required now (Phase 0-3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required from Phase 4 (classify_intent, ticket_interpreter, graph_rag_chain
# synthesis — every LLM call in this project is Claude)
ANTHROPIC_API_KEY=

# Required from Phase 6 (KB article embeddings — neo4j-graphrag's
# OpenAIEmbeddings reads this from the environment directly, no config.py wiring needed)
OPENAI_API_KEY=

# Required from Phase 4+ (agent tracing) — not needed yet
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=super-agent-kg

# Required only for the Slack bot (see slack_bot/slack_setup.md)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Optional: limit /agent to these channel IDs, separated by commas
SLACK_ALLOWED_CHANNELS=
# Optional: only these Slack user IDs may use the bot (comma-separated)
SLACK_ALLOWED_USERS=

# Optional: where saved conversations are stored (default checkpoints.db)
CHECKPOINT_DB=
