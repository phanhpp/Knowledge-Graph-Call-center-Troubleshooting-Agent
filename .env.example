# Required now (Phase 0-3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required from Phase 4 (classify_intent, ticket_interpreter, graph_rag_chain
# synthesis — every LLM call in this project is Claude)
ANTHROPIC_API_KEY=

# Required from Phase 6 (KB article embeddings — neo4j-graphrag's
# OpenAIEmbeddings reads this from the environment directly, no config.py wiring needed)
OPENAI_API_KEY=

# Required from Phase 4+ (agent tracing) — not needed yet
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=super-agent-kg
